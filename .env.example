# Copy this file to .env and add your OpenRouter API key.
OPEN_ROUTER_API_KEY=

# Optional overrides. Uncomment only what you want to change.
# EXTRACT_MODEL=google/gemini-2.5-flash-lite
# ESCALATION_MODEL=google/gemini-3-flash-preview
# PICK_MODEL=google/gemini-3-flash-preview
# TAXONOMY_RETRIEVAL=union  # union or lexical

# The extractor can write elsewhere, but the server currently reads output/.
# OUTPUT_DIR=output
